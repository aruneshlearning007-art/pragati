{
  "name": "pragati",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @pragati/web dev",
    "build": "pnpm --filter @pragati/db generate && pnpm --filter @pragati/shared build && pnpm --filter @pragati/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
